<?xml version="1.0" encoding="utf-8"?>
<!-- The build uses a generated copy of this file (generateManifest task)
     with the @generated-*@ markers expanded from the schema files in
     schemas/. Edit AndroidManifest.template.xml for static content; edit
     the schemas for hosts, paths, and target packages — never the
     generated manifest under build/. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ package visibility. Target app packages are generated
         from the schemas' target.android.package fields. The https intent
         grants visibility of link handlers for the "reopen elsewhere"
         fallback when resolution fails. -->
    <queries>
        <!-- @generated-queries@ -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:theme="@style/Theme.PodDispatcher"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- One intent filter per source schema, generated from its hosts
             and android.paths. Android limitation: filters are baked in at
             build time, so a brand-new host is intercepted from the next
             release; OTA updates can only change how known hosts parse. -->
        <activity
            android:name=".ui.DispatchActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.PodDispatcher.Translucent">
            <!-- Share-sheet fallback: unlike the generated VIEW filters below,
                 SEND is not host-restricted. Links whose hosts aren't
                 intercepted yet — e.g. a source schema delivered OTA before
                 the next release — still work by sharing them to
                 Pod Dispatcher. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <!-- @generated-intent-filters@ -->
        </activity>
    </application>
</manifest>
